<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cercul exterior -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#3B2E2A" />
        </shape>
    </item>

    <!-- Cercul interior -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">

        <shape android:shape="oval">
            <solid android:color="#3B2E2A" />
        </shape>

    </item>

</layer-list>